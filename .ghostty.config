confirm-close-surface = false
window-padding-x = 20
window-padding-y = 10
background = #0A0A0A
window-titlebar-background = #0A0A0A
font-feature = true
font-family = VictorMono Nerd Font
macos-titlebar-style = tabs
macos-titlebar-proxy-icon = hidden
background-opacity = 0.8
background-blur = 80
keybind = shift+enter=text:\x1b\r
macos-icon = custom
macos-custom-icon = "/Users/manik/Documents/System & Config/Icons/ghostty.png"
